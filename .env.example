# Optional machine-specific settings for the independent benchmark installation.
# Copy to .env in ~/sharp-benchmarks; never commit real credentials.
# Every setting is optional. Keep evaluation thresholds on the command line.

# Default: <benchmark installation>/data, with raw/interim/processed/mock below it.
#SHARP_DATA_ROOT=/scratch/$USER/sharp-benchmarks-data
#SHARP_RAW_DIR=${SHARP_DATA_ROOT}/raw
#SHARP_INTERIM_DIR=${SHARP_DATA_ROOT}/interim
#SHARP_PROCESSED_DIR=${SHARP_DATA_ROOT}/processed
#SHARP_MOCK_DIR=${SHARP_DATA_ROOT}/mock

# Optional: higher NCBI E-utilities download rate limit.
#NCBI_API_KEY=

# Shell-script settings. Existing environment variables win over these defaults.
# DATABASES may be supplied by your server.
TOOLS_INSTALL_DIR="${TOOLS_INSTALL_DIR:-$HOME/.local/src}"
DEEPBGC_DOWNLOADS_DIR="${DEEPBGC_DOWNLOADS_DIR:-${DATABASES:-$HOME/.local/share}/deepbgc/data}"
ANTISMASH_DOWNLOADS_DIR="${ANTISMASH_DOWNLOADS_DIR:-${DATABASES:-$HOME/.local/share}/antismash/databases}"
POOL_ROOT="${POOL_ROOT:-$HOME/projects}"

# Slurm reads this from the exported environment, not this file:
# export SHARP_BENCHMARKS_DIR=/scratch/$USER/sharp-benchmarks
# Baseline tool/database paths and cluster directives remain explicit in .sbatch.
